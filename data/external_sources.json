{
  "x_octane_ddr": {
    "description": "DDR4 and DDR5 hardware-counter telemetry from the X-OCTANE repository. This is the main CITADEL input for CPU-DRAM CINTAS experiments.",
    "repo": "ping830616/X-OCTANE",
    "ref": "main",
    "path": "data/TELEMETRY_DATA",
    "target": "data/telemetry/processed/x_octane_ddr",
    "preserve_tree": false,
    "kind": "hardware_counter",
    "filename_schema": "DDR{4,5}_{benign,DROOP,RH,SPECTRE}_{workload}.csv",
    "setups": {
      "DDR4": "Setup A",
      "DDR5": "Setup B"
    },
    "expected": {
      "files": 78,
      "bytes": 1228158106,
      "scenarios": ["benign", "DROOP", "RH", "SPECTRE"],
      "workloads": ["dft", "dj", "dp", "gs", "gl", "ha", "ja", "mm", "ni", "oe", "pi", "sh", "tr"]
    }
  },
  "dice_m2pro_tiers": {
    "description": "Apple M2 Pro tier-0, tier-1, and tier-2 limited-observability telemetry from the DICE repository. CITADEL tracks it for platform-diversity and observability studies, separate from CINTAS hardware-cost claims.",
    "repo": "ping830616/DICE",
    "ref": "main",
    "path": "data generation/dataset/ITC_M2Pro_DATA",
    "target": "data/telemetry/raw/dice_m2pro_tiers",
    "preserve_tree": true,
    "kind": "limited_observability_host",
    "include_prefixes": ["tier0/", "tier1_alt/", "tier2/"],
    "tier_aliases": {
      "tier0": "tier0",
      "tier1_alt": "tier1",
      "tier2": "tier2"
    },
    "expected": {
      "files": 120,
      "bytes": 130137440,
      "tiers": ["tier0", "tier1_alt", "tier2"]
    }
  }
}
