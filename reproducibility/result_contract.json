{
  "schema_version": 1,
  "description": "Scientific-equivalence contract for independently generated CITADEL result tables. Numeric CSV and JSON values use declared tolerances; categorical values and schemas are exact. CSV row order is exact unless a rule declares scientific identity keys. Optional rules are compared whenever the reference run contains that output; candidate-only optional outputs are reported as unverified.",
  "informational_output_globs": [
    "**/run_manifest.json",
    "workload_profiles/manifest.json",
    "fpga/golden_vector_manifest.json",
    "droop_adaptive_data/*.csv.cache.json"
  ],
  "ignore_csv_columns": [
    "droop_adaptive_out_root"
  ],
  "unordered_delimited_csv_columns": {
    "selected_features": "|",
    "features": ","
  },
  "ignore_json_keys": [
    "created_at_utc",
    "finished_at_utc",
    "generated_at_utc",
    "git_dirty",
    "git_dirty_at_start",
    "git_status_at_start",
    "output_files",
    "output_root",
    "platform",
    "python_executable",
    "repository_commit",
    "runtime_seconds",
    "started_at_utc"
  ],
