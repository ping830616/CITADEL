# Copy this file to collection.env and replace every required value.
# Use absolute paths. Do not commit machine specific credentials.

PAMPAR_ROOT=/absolute/path/to/PAMPAR
PCM_ROOT=/absolute/path/to/pcm
PCM_BIN=/absolute/path/to/pcm/build/bin/pcm
OUTPUT_ROOT=/absolute/path/to/citadel_traces

# Existing workload directories are preserved unless this is set to YES.
ALLOW_OVERWRITE=NO

# Intel PCM settings used by the preserved PAMPAR scripts.
PCM_INTERVAL_S=0.001
PCM_ITERATIONS=1000

# Replacement voltage and temperature collector settings.
SENSOR_SAMPLES=200
SENSOR_INTERVAL_S=0.005
MSR_CPU=0
MSR_REGISTER=0x198
RDMSR_BIN=/usr/sbin/rdmsr
SUDO_BIN=sudo

# The historical DROOP arguments were not retained in the repository.
# Recover and enter the exact arguments before enabling DROOP collection.
ENABLE_DROOP=NO
DROOP_ARGS_DDR4=
DROOP_ARGS_DDR5=

# The historical Game of Life launchers were not retained. Enter the exact
# platform commands if these workloads are needed.
GL_COMMAND_DDR4=
GL_COMMAND_DDR5=

# Optional external tool checkouts used by record_environment.sh.
PLUNDERVOLT_ROOT=
TRRESPASS_ROOT=
SPECTRE_ROOT=
